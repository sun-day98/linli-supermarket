.pc {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.04);
}

.pc__image-wrap {
  position: relative;
  width: 100%;
  height: 330rpx;
  background: #f0f2f5;
}

.pc__image {
  width: 100%;
  height: 100%;
}

.pc__tag {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  background: rgba(245, 34, 45, 0.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.pc__body {
  padding: 16rpx 18rpx 20rpx;
}

.pc__name {
  font-size: 27rpx;
  font-weight: 600;
}

.pc__row {
  margin: 8rpx 0 6rpx;
}

.pc__add {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
}
