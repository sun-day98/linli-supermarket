.detail {
  padding-bottom: 160rpx;
}

.detail__image {
  width: 100%;
  height: 750rpx;
  background: #f0f2f5;
}

.detail__price {
  position: relative;
  margin-top: -20rpx;
}

.detail__price-main {
  font-size: 48rpx;
}

.detail__origin {
  text-decoration: line-through;
  margin-left: 16rpx;
}

.detail__name {
  font-size: 32rpx;
  font-weight: 700;
}

.detail__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 28rpx;
  color: #8a9199;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.detail__text {
  color: #8a9199;
  font-size: 26rpx;
  line-height: 1.7;
  margin: 12rpx 0;
}

.review {
  border-bottom: 1rpx solid #ebedf0;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.review__stars {
  color: #ffb400;
}

.review__content {
  margin: 8rpx 0;
}

.detail__bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #ebedf0;
  z-index: 100;
}
