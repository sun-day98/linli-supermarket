.hero {
  background: linear-gradient(135deg, #07c160, #34c759);
  color: #fff;
  padding: 36rpx 28rpx 28rpx;
  border-radius: 0 0 36rpx 36rpx;
}

.hero__name {
  font-size: 40rpx;
  font-weight: 700;
}

.hero__slogan {
  font-size: 24rpx;
  opacity: 0.9;
}

.hero__badge {
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}

.hero__search {
  margin-top: 26rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  color: #8a9199;
  font-size: 26rpx;
}

.notice {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8a9199;
}

.notice__label {
  color: #07c160;
  font-weight: 700;
  margin-right: 14rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 8rpx;
  text-align: center;
}

.category-grid__item image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.category-grid__item text {
  font-size: 24rpx;
}

.view-all {
  text-align: center;
  color: #07c160;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 24rpx;
}
