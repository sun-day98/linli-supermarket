<view class="page login-page page--plain">
  <view class="login-hero">
    <view class="login-hero__logo">邻</view>
    <view class="login-hero__title">邻里小超</view>
    <view class="login-hero__slogan">新鲜到家，邻里共享</view>
  </view>

  <view class="card login-form">
    <view class="field">
      <view class="field__label">手机号</view>
      <input class="field__input" type="number" maxlength="11" placeholder="请输入手机号"
             value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="field">
      <view class="field__label">验证码</view>
      <input class="field__input" type="number" maxlength="6" placeholder="演示验证码 123456"
             value="{{code}}" bindinput="onCodeInput" />
    </view>
    <view class="login-form__tip">演示环境验证码固定为 123456，新手机号将自动注册并赠送新人券。</view>
    <view class="btn login-form__submit {{submitting ? 'btn--disabled' : ''}}" bindtap="onSubmit">登录 / 注册</view>
  </view>
</view>
