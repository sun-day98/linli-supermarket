.user-panel {
  background: linear-gradient(135deg, #07c160, #06ad56);
  padding: 48rpx 32rpx 56rpx;
  color: #fff;
}

.user-panel__logged,
.user-panel__guest {
  min-height: 120rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  flex: none;
}

.avatar--guest {
  background: rgba(255, 255, 255, 0.2);
}

.user-panel__info {
  flex: 1;
  min-width: 0;
  padding: 0 24rpx;
}

.user-panel__name {
  font-size: 34rpx;
  font-weight: 700;
}

.user-panel__phone {
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

.user-panel__points {
  text-align: center;
  flex: none;
}

.user-panel__points-num {
  font-size: 44rpx;
  font-weight: 700;
}

.user-panel__points .muted {
  color: rgba(255, 255, 255, 0.85);
}

.user-panel__arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.8);
}

.order-entry {
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

.order-entry__title {
  font-weight: 700;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.order-entry__grid {
  display: flex;
  padding-top: 24rpx;
}

.order-entry__item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #4e5969;
}

.order-entry__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f8ef;
  color: #07c160;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin: 0 auto 12rpx;
}

.tool-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.tool-row:last-child {
  border-bottom: none;
}

.tool-row__icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  margin-right: 20rpx;
  flex: none;
}

.tool-row__icon--coupon { background: #f2270c; }
.tool-row__icon--point { background: #ff8f1f; }
.tool-row__icon--addr { background: #4096ff; }
.tool-row__icon--service { background: #07c160; }

.tool-row__extra {
  margin-left: auto;
  font-size: 24rpx;
}

.logout {
  display: block;
  width: calc(100% - 48rpx);
  text-align: center;
  margin: 24rpx;
}
