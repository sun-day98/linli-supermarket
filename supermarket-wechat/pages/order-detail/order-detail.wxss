.status-banner {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  padding: 44rpx 32rpx 40rpx;
}

.status-banner--0 { background: linear-gradient(135deg, #f2270c, #ff6034); }
.status-banner--2 { background: linear-gradient(135deg, #ff8f1f, #ffb648); }
.status-banner--4 { background: linear-gradient(135deg, #8a9199, #b8bfc6); }

.status-banner__text {
  font-size: 44rpx;
  font-weight: 700;
}

.status-banner__hint {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

.detail-receiver {
  font-size: 30rpx;
  font-weight: 700;
}

.detail-address {
  margin-top: 10rpx;
  line-height: 1.6;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.detail-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  flex: none;
}

.detail-item__body {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.detail-item__body .muted {
  margin-top: 8rpx;
}

.amount-line {
  padding: 8rpx 0;
  font-size: 26rpx;
}

.amount-line--total {
  border-top: 1rpx solid #f2f3f5;
  margin-top: 10rpx;
  padding-top: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-extra {
  margin-top: 14rpx;
  line-height: 1.5;
}

.detail-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx;
}

.detail-bar .btn {
  padding: 16rpx 36rpx;
}
