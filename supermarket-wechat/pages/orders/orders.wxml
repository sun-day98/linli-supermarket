<view class="page orders-page">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="label"
          class="tab {{activeTab === index ? 'tab--active' : ''}}"
          data-index="{{index}}" bindtap="onTabChange">{{item.label}}</view>
  </view>

  <view wx:for="{{orders}}" wx:key="id" class="card order-card">
    <view class="row-between order-card__head">
      <view class="muted">订单号 {{item.orderNo}}</view>
      <view class="order-status status-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="order-card__body" data-id="{{item.id}}" bindtap="onOrderTap">
      <image wx:if="{{item.firstImage}}" src="{{item.firstImage}}" mode="aspectFill" />
      <view class="order-card__info">
        <view class="ellipsis">{{item.itemSummary}}</view>
        <view class="muted">{{item.createdText}}</view>
      </view>
      <view class="price">{{item.payText}}</view>
    </view>
    <view class="order-card__actions">
      <view wx:if="{{item.status === 0}}" class="btn btn--danger" data-id="{{item.id}}" bindtap="onCancel">取消订单</view>
      <view wx:if="{{item.status === 0}}" class="btn" data-id="{{item.id}}" bindtap="onPay">去支付</view>
      <view wx:if="{{item.status === 2}}" class="btn" data-id="{{item.id}}" bindtap="onFinish">确认收货</view>
    </view>
  </view>

  <view wx:if="{{orders.length === 0}}" class="empty">暂无相关订单，去逛逛吧</view>

  <tab-bar current="orders" />
</view>
