.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #ebedf0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 26rpx;
  color: #646a73;
  position: relative;
}

.tab--active {
  color: #07c160;
  font-weight: 700;
}

.tab--active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #07c160;
  border-radius: 4rpx;
}

.order-card {
  padding: 22rpx 26rpx;
}

.order-card__head {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.order-status {
  font-size: 26rpx;
  font-weight: 700;
  color: #07c160;
}

.order-status.status-0 { color: #f2270c; }
.order-status.status-2 { color: #ff8f1f; }
.order-status.status-4 { color: #8a9199; }

.order-card__body {
  display: flex;
  align-items: center;
  padding: 22rpx 0 8rpx;
}

.order-card__body image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  flex: none;
}

.order-card__info {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.order-card__info .muted {
  margin-top: 10rpx;
}

.order-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
}

.order-card__actions .btn {
  padding: 12rpx 28rpx;
}
